# .env.example — Plantilla de variables de entorno
#
# INSTRUCCIONES:
#   1. Copiá este archivo como .env en la raíz del proyecto
#   2. Completá los valores con los datos reales
#   3. NUNCA subas el .env a Git (ya está en .gitignore)

# ── Flask ────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=cambia-esto-por-una-clave-secreta-larga-y-random

# ── Base de datos SQLite ─────────────────────────────────
DB_PATH=prode.db

# ── Aplicación ───────────────────────────────────────────
NOMBRE_EMPRESA=Mi Empresa
NOMBRE_EMPRESA_XL=Mi Empresa S.A.
NOMBRE_APLICACION=Prode
VERSION=1.0.0
ANO_COPYRIGHT=2026
BASE_URL=http://127.0.0.1:5000

# ── Google OAuth ─────────────────────────────────────────
# Obtené las credenciales en: https://console.cloud.google.com/
#   1. Crear proyecto → APIs y servicios → Credenciales → OAuth 2.0
#   2. Tipo: Aplicación web
#   3. URI de redirección: http://localhost:5000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (SMTP) — opcional, para notificaciones ─────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=tu@gmail.com
MAIL_PASSWORD=tu-app-password
MAIL_DEFAULT_SENDER=Prode <tu@gmail.com>
